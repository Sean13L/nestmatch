# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nestmatch"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (magic-link + match notification emails)
RESEND_API_KEY=""
EMAIL_FROM="NestMatch <notifications@yourdomain.com>"

# Listing provider(s) — see lib/providers/README.md for how to add more.
# Without these set, the app falls back to the bundled mock provider so local
# dev works with zero external accounts (same "mock fallback" pattern as
# rentcastProvider below).
RENTCAST_API_KEY=""
# Responses are cached in the DB for this many hours; the monthly cap stops
# real API calls once reached (stale cache is served instead). Set the cap
# to your RentCast plan's monthly request quota.
RENTCAST_CACHE_HOURS="12"
RENTCAST_MONTHLY_REQUEST_LIMIT="45"

# Neighborhood data (fitness/student life/community/food/recreation) via
# Google Places API (New). Optional — listing pages just omit the
# neighborhood section when unset. Each uncached listing view costs up to 5
# requests (one per category); the cap below stops calls for the rest of the
# month once reached.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT="4500"

# Cron auth — Vercel Cron sends this as a bearer token; reject requests to
# /api/cron/* that don't present it.
CRON_SECRET="generate-a-random-string"
